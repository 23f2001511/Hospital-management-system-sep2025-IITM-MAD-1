# ===== Flask =====
# Change this to a long random string in production. Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ===== Database =====
# SQLite (default, local development):
DATABASE_URL=sqlite:///hospital_management.db
# PostgreSQL (production - use a free external provider like Neon or Supabase so it never expires):
# DATABASE_URL=postgresql://user:password@host/dbname

# ===== Flask-Mail (optional - if omitted, emails are logged to the console) =====
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_DEFAULT_SENDER=your_email@gmail.com

# ===== Server =====
# Port used by gunicorn/eventlet on the host (Render sets this automatically)
PORT=5000
